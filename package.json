{
  "name": "cubic",
  "version": "3.8.8",
  "private": true,
  "description": "Mobile 3D rolling-block puzzle built with Cocos Creator.",
  "scripts": {
    "levels:import": "node tools/import-bloxorz-levels.mjs",
    "levels:solutions": "tsc -p tsconfig.tests.json && node tools/generate-bloxorz-solutions.mjs",
    "test": "tsc -p tsconfig.tests.json && node dist-tests/tests/run-tests.js",
    "test:engine": "npm run test",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck:cocos",
    "typecheck:cocos": "tsc -p tsconfig.cocos-check.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "creator": {
    "version": "3.8.8"
  },
  "uuid": "1b073428-bcea-4d8d-9948-71dfc65aa9f9"
}
